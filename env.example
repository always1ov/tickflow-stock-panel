# 复制整段粘贴到 Dokploy 的 Environment 页，按需改值

# 容器名，全机器唯一
APP_NAME=tickflow-panel

# 镜像 tag: latest=跟随 claude/upstream-clean 最新;
# 回滚改成 FORK_NOTES.md 存档表里的提交号(如 24ce014)再 Deploy
IMAGE_TAG=latest

# NAS 内网 IP，端口只绑这个地址
HOST_IP=192.168.1.100

# 宿主机端口，避开主栈占用的 80 443 3000 8080 8888 和已部署应用的端口
HOST_PORT=3018

# 公网域名(Cloudflare Tunnel / 内网 HTTPS 共用) —— 真实值只填在 Dokploy 面板里, 别写回仓库
APP_DOMAIN=tickflow.example.com

# [可选] 国内直连域名(灰云 A 记录指国内VPS, frp TCP 转发到家). 不用国内线路就删掉这行
APP_DOMAIN_CN=cn.example.com

# 首次启动的登录密码(迁移了旧 data 则沿用旧密码, 此值被忽略)。别含 $ 字符
AUTH_PASSWORD=changeme

# [可选] 免登录模式: 设为 1 则完全关闭面板登录(公网也放行, 谁都能进!)。
# 仅在前面另有一道门(如 Cloudflare Access)时使用; 删掉这行重新 Deploy 即恢复登录
# AUTH_DISABLED=1
